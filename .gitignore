# =============================================================================
# meetings-app — only source, config templates, and lockfiles belong on GitHub
# =============================================================================

# --- Dependencies ---
node_modules/

# --- Environment & secrets (never commit real keys) ---
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
*.local

# HTTP cookie jars / curl dumps (often contain session tokens)
cookies.txt
**/cookies.txt

# --- Build outputs ---
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.turbo/
.vercel/

# --- Tooling caches ---
.cache/
.parcel-cache/
.vite/
.eslintcache
*.tsbuildinfo

# --- Logs & debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Tests & coverage ---
coverage/
.nyc_output/

# --- OS junk ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editor / IDE ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json

# --- Docker (machine-specific overrides) ---
docker-compose.override.yml
**/docker-compose.override.yml

# --- Local data / dumps (should never be in repo) ---
*.rdb
dump.rdb
data/mongo/
data/redis/

# --- Certificates (if added locally) ---
*.pem
*.key
!**/fixtures/**/*.pem

# --- Merge / patch leftovers ---
*.orig
*.rej

# --- Misc temp ---
tmp/
temp/
*.pid
*.seed
