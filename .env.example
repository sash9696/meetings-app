JWT_SECRET=change-me-in-production-use-long-random-string

# Registration with this email gets admin role (optional)
ADMIN_EMAIL=

# MongoDB (Docker default)
MONGODB_URI=mongodb://mongo:27017/meeting_intel

# Redis (Docker service name)
REDIS_HOST=redis
REDIS_PORT=6379

# Worker: set MOCK_LLM=false and point Ollama when ready (host Ollama from container)
MOCK_LLM=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2