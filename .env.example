JWT_SECRET=change-me-in-production-use-long-random-string

# Registration with this email gets admin role (optional)
ADMIN_EMAIL=

# MongoDB: use host mongo for full Docker Compose (infra/docker-compose.yml sets this too).
# For API/worker on your machine with only mongo/redis containers, use:
# MONGODB_URI=mongodb://127.0.0.1:27017/meeting_intel
MONGODB_URI=mongodb://mongo:27017/meeting_intel

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Worker: mock summaries without calling OpenAI
MOCK_LLM=true

# When MOCK_LLM=false, paste your key (e.g. sk-...). Optional: OPENAI_MODEL (default gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
